# Скопируйте в .env и при необходимости измените
HTTP_PORT=80
PUBLIC_URL=http://localhost          # внешний адрес сервера, например https://proof.example.ru
JWT_SECRET=change-me-in-production
DB_PASSWORD=proof
DEMO_MODE=true                        # ссылка подтверждения email показывается на экране (для проверки жюри)
SEED_ON_START=true                    # демо-данные: 360 синтетических кандидатов, компании, приглашения
MAIL_UI_PORT=8025                     # веб-интерфейс почты Mailpit (письма подтверждения)
# DEBIAN_MIRROR=http://mirror.yandex.ru  # если deb.debian.org недоступен из сети сервера
# Реальная почта вместо Mailpit:
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_USER=...
# SMTP_PASS=...
# Российские LLM (необязательно; без ключей работают правила):
# GIGACHAT_AUTH_KEY=...
# YANDEX_API_KEY=...
# YANDEX_FOLDER_ID=...
# «Маринад» и регулярные задачи (по умолчанию):
# CALIBRATE_EVERY=300        # перекалибровка теста каждые N новых ответов
# RANKER_EVERY=20            # дообучение подбора каждые N ответов на приглашения
# PRACTICE_EVERY_DAYS=7      # «Свежая начинка»: адресная задача кандидату не чаще раза в N дней
